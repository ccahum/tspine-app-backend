# Plantilla de variables para docker-compose.app.yml — copia este archivo como .env.qa
# o .env.prod en el servidor (según el ambiente) y rellena los valores reales.
# NO subas .env.qa ni .env.prod al repositorio.
#
# DATABASE_URL ya NO se define aquí — docker-compose.app.yml la arma automáticamente
# a partir de POSTGRES_PASSWORD y POSTGRES_DB.

# Nombre corto del ambiente: se usa como nombre de proyecto de Docker Compose (-p) y como
# alias de red para que Caddy encuentre el backend correcto (ej. "qa" o "prod").
ENV_NAME=qa

# Nombre de la base de datos de este ambiente (distinto por ambiente para no mezclar datos).
POSTGRES_DB=tspine_qa_db

POSTGRES_PASSWORD="CAMBIA_ESTO"
JWT_SECRET="GENERA_UN_STRING_ALEATORIO_LARGO_AQUI"
JWT_EXPIRES_IN="8h"
# Clave para cifrar en reposo el secreto TOTP (2FA) de cada usuario — 32 bytes en hex (64 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY="GENERA_UNA_CLAVE_HEX_DE_64_CARACTERES_AQUI"
PORT=3000
LOG_LEVEL=info

# Orígenes permitidos por CORS, separados por comas (sin espacios extra necesarios).
# Ejemplo para QA:
CORS_ORIGINS=https://qa.luminar-tspine.com
# Ejemplo para producción:
# CORS_ORIGINS=https://app.luminar-tspine.com

# Integración de Google Chat (botón "Enviar por Gmail"). La cuenta de servicio es la misma
# para todos los ambientes (un solo proyecto de Google Cloud) — lo que SÍ cambia por ambiente
# son los Space ID: en QA usa un espacio de prueba (para no mandar PDFs reales al chat del
# negocio), en producción los espacios reales de ChatGDL/ChatYucatán.
# JSON de la cuenta de servicio, codificado en base64 (nunca subir el .json en texto plano):
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   Linux/macOS:          base64 -w0 service-account.json
GOOGLE_CHAT_SA_KEY_BASE64=""
# Ejemplo para QA (espacio(s) de prueba — reemplaza con el ID real que crees):
GOOGLE_CHAT_SPACE_GDL="spaces/CAMBIA_ESTO_QA"
GOOGLE_CHAT_SPACE_YUCATAN="spaces/CAMBIA_ESTO_QA"
# Ejemplo para producción:
# GOOGLE_CHAT_SPACE_GDL="spaces/AAAA4Vn0qzk"
# GOOGLE_CHAT_SPACE_YUCATAN="spaces/AAAAt0fF3uo"
