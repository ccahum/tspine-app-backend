generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pais {
  id       String    @id @default(uuid())
  nombre   String    @unique
  estados  Estado[]
  terceros Tercero[]

  @@map("paises")
}

model Estado {
  id       String    @id @default(uuid())
  nombre   String
  paisId   String?   @map("pais_id")
  ciudades Ciudad[]
  pais     Pais?     @relation(fields: [paisId], references: [id])
  terceros Tercero[]

  @@map("estados")
}

model Ciudad {
  id         String      @id @default(uuid())
  nombre     String
  estadoId   String?     @map("estado_id")
  estado     Estado?     @relation(fields: [estadoId], references: [id])
  hospitales Hospital[]
  terceros   Tercero[]

  @@map("ciudades")
}

model RegimenFiscal {
  id            String          @id
  descripcion   String
  datosFiscales DatosFiscales[]

  @@map("regimenes_fiscales")
}

model UsoCfdi {
  id                  String          @id
  descripcion         String
  aplicaPersonaFisica Boolean         @default(false) @map("aplica_persona_fisica")
  aplicaPersonaMoral  Boolean         @default(false) @map("aplica_persona_moral")
  datosFiscales       DatosFiscales[]

  @@map("usos_cfdi")
}

model Cargo {
  id       String    @id @default(uuid())
  nombre   String    @unique
  terceros Tercero[]

  @@map("cargos")
}

model FormaPago {
  id       String   @id
  forma    String
  efectivo Boolean  @default(false)
  tc       Boolean?
  tarifas         Tarifa[]
  valConsumos     ValConsumo[]
  gastos          Gasto[]
  compras         Compra[]
  movimientosCaja MovimientoCaja[]
  mirs            Mir[]
  pagosEjecucion  PagoEjecucion[]
  abonos          Abono[]

  @@map("formas_pago")
}

model Banco {
  id     String @id
  nombre String

  cuentas         Cuenta[]
  movimientosCaja MovimientoCaja[]
  pagosEjecucion  PagoEjecucion[]
  abonos          Abono[]

  @@map("bancos")
}

model ClasificacionGasto {
  id            String @id
  clasificacion String

  tiposPago TipoPago[]
  gastos    Gasto[]

  @@map("clasificaciones_gasto")
}

model ConceptoMovimiento {
  id       String  @id
  concepto String?
  tipo     String?

  movimientosCaja MovimientoCaja[]

  @@map("conceptos_movimientos")
}

model MovimientoCaja {
  id                  String    @id
  usuarioId           String?   @map("usuario_id")
  marcaTiempo         DateTime? @map("marca_tiempo")
  empresaId           String?   @map("empresa_id")
  sedeId              String?   @map("sede_id")
  tipo                String?
  contactoId          String?   @map("contacto_id")
  numRecaudo          String?   @map("num_recaudo")
  fecha               DateTime? @db.Date
  formaRecaudoId      String?   @map("forma_recaudo_id")
  cuentaId            String?   @map("cuenta_id")
  destinoId           String?   @map("destino_id")
  valor               Decimal?  @db.Decimal(15, 2)
  porcentajeComision  Decimal?  @map("porcentaje_comision") @db.Decimal(5, 2)
  funcionarioRecibeId String?   @map("funcionario_recibe_id")
  conceptoId          String?   @map("concepto_id")
  observaciones       String?
  noRec               String?   @map("no_rec")
  status              String?
  tipoDeRecaudo       String?   @map("tipo_de_recaudo")
  porcentaje          Decimal?  @db.Decimal(5, 2)
  imagenSoporte       String?   @map("imagen_soporte")
  archivoSoporte      String?   @map("archivo_soporte")

  usuario           Tercero?            @relation("MovimientoCajaUsuario",     fields: [usuarioId],           references: [id])
  empresa           Tercero?            @relation("MovimientoCajaEmpresa",     fields: [empresaId],           references: [id])
  sede              Sede?               @relation(                            fields: [sedeId],              references: [id])
  contacto          Tercero?            @relation("MovimientoCajaContacto",   fields: [contactoId],          references: [id])
  formaRecaudo      FormaPago?          @relation(                            fields: [formaRecaudoId],      references: [id])
  cuenta            Cuenta?             @relation(                            fields: [cuentaId],            references: [id])
  destino           Banco?              @relation(                            fields: [destinoId],           references: [id])
  funcionarioRecibe Tercero?            @relation("MovimientoCajaFuncionario", fields: [funcionarioRecibeId], references: [id])
  concepto          ConceptoMovimiento? @relation(                            fields: [conceptoId],          references: [id])
  programacionPagos ProgramacionPago[]
  pagosEjecucion    PagoEjecucion[]
  abonos            Abono[]

  @@map("movimientos_caja")
}

model Mir {
  id                 String    @id
  marcaTiempo        DateTime? @map("marca_tiempo")
  tipoMovimiento     String?   @map("tipo_movimiento")
  conceptoMovimiento String?   @map("concepto_movimiento")
  generaComision     Boolean?  @map("genera_comision")
  tipoPagoId         String?   @map("tipo_pago_id")
  comision           Decimal?  @db.Decimal(5, 2)
  usuarioId          String?   @map("usuario_id")
  numRegistro        String?   @map("num_registro")
  fecha              DateTime? @db.Date
  origenId           String?   @map("origen_id")
  cuentaOrigenId     String?   @map("cuenta_origen_id")
  formaMovimientoId  String?   @map("forma_movimiento_id")
  destinoId          String?   @map("destino_id")
  cuentaDestinoId    String?   @map("cuenta_destino_id")
  valor              Decimal?  @db.Decimal(15, 2)
  descripcion        String?
  imagenSoporte      String?   @map("imagen_soporte")
  archivoPdf         String?   @map("archivo_pdf")
  proyectoId         String?   @map("proyecto_id")
  perteneceAProyecto Boolean?  @map("pertenece_a_proyecto")

  tipoPago        TipoPago?  @relation(                    fields: [tipoPagoId],        references: [id])
  usuario         Tercero?   @relation("MirUsuario",       fields: [usuarioId],         references: [id])
  origen          Tercero?   @relation("MirOrigen",        fields: [origenId],          references: [id])
  cuentaOrigen    Cuenta?    @relation("MirCuentaOrigen",  fields: [cuentaOrigenId],    references: [id])
  formaMovimiento FormaPago? @relation(                    fields: [formaMovimientoId], references: [id])
  destino         Tercero?   @relation("MirDestino",       fields: [destinoId],         references: [id])
  cuentaDestino   Cuenta?    @relation("MirCuentaDestino", fields: [cuentaDestinoId],   references: [id])
  proyecto        Proyecto?  @relation(                    fields: [proyectoId],        references: [id])
  programacionPagos ProgramacionPago[]

  @@map("mir")
}

model TipoPago {
  id             String  @id
  clasificacionId String? @map("clasificacion_id")
  descripcion    String?
  frecuencia     String?
  observaciones  String?

  clasificacion ClasificacionGasto? @relation(fields: [clasificacionId], references: [id])
  gastos        Gasto[]
  mirs          Mir[]

  @@map("tipos_pago")
}

model ProgramacionPago {
  id                    String    @id
  marcaTiempo           DateTime? @map("marca_tiempo")
  fechaOrigenMovimiento DateTime? @map("fecha_origen_movimiento") @db.Date
  fechaPago             DateTime? @map("fecha_pago")              @db.Date
  programadoPorId       String?   @map("programado_por_id")
  beneficiarioGastoId   String?   @map("beneficiario_gasto_id")
  beneficiarioPagoId    String?   @map("beneficiario_pago_id")
  folioRelacionado      String?   @map("folio_relacionado")
  tipo                  String?
  provieneDe            String?   @map("proviene_de")
  folioGastoId          String?   @map("folio_gasto_id")
  folioCompraId         String?   @map("folio_compra_id")
  folioComisionesId     String?   @map("folio_comisiones_id")
  folioMirId            String?   @map("folio_mir_id")
  segmentador           String?
  tipoDePago            String?   @map("tipo_de_pago")
  cuentaContable        String?   @map("cuenta_contable")
  folioCajaId           String?   @map("folio_caja_id")
  comision              Decimal?  @db.Decimal(15, 2)
  sede                  String?

  programadoPor     Tercero?        @relation("ProgramacionPagoProgramadoPor",     fields: [programadoPorId],     references: [id])
  beneficiarioGasto Tercero?        @relation("ProgramacionPagoBeneficiarioGasto", fields: [beneficiarioGastoId], references: [id])
  beneficiarioPago  Tercero?        @relation("ProgramacionPagoBeneficiarioPago",  fields: [beneficiarioPagoId],  references: [id])
  folioGasto        Gasto?          @relation(                                     fields: [folioGastoId],       references: [id])
  folioCompra       Compra?         @relation(                                     fields: [folioCompraId],      references: [id])
  folioComisiones   DetTecnico?     @relation(                                     fields: [folioComisionesId],  references: [id])
  folioMir          Mir?            @relation(                                     fields: [folioMirId],         references: [id])
  folioCaja         MovimientoCaja? @relation(                                     fields: [folioCajaId],        references: [id])
  pagosEjecucion    PagoEjecucion[]

  @@map("programacion_pagos")
}

model PagoEjecucion {
  id                    String    @id @map("id_pago")
  registradoPorId       String?   @map("registrado_por_id")
  marcaTiempo           DateTime? @map("marca_tiempo")
  programacionPagoId    String?   @map("programacion_pago_id")
  fechaDeRegistro       DateTime? @map("fecha_de_registro")        @db.Date
  ejecutado             Boolean?
  fechaProgramado       DateTime? @map("fecha_programado")         @db.Date
  fechaDeEjecucionFecha DateTime? @map("fecha_de_ejecucion_fecha") @db.Date
  beneficiarioGastoId   String?   @map("beneficiario_gasto_id")
  beneficiarioPagoId    String?   @map("beneficiario_pago_id")
  saldoPorConciliar     Decimal?  @map("saldo_por_conciliar")      @db.Decimal(15, 2)
  monto                 Decimal?  @db.Decimal(15, 2)
  formaPagoId           String?   @map("forma_pago_id")
  cuentaId              String?   @map("cuenta_id")
  origenId              String?   @map("origen_id")
  notas                 String?
  folioRelacionado      String?   @map("folio_relacionado")
  comprobantePago       String?   @map("comprobante_pago")
  conciliarPagosId      String?   @map("conciliar_pagos_id")
  archivoPago           String?   @map("archivo_pago")
  saldo                 Decimal?  @db.Decimal(15, 2)
  tipoDeComprobante     String?   @map("tipo_de_comprobante")
  archivoPago2          String?   @map("archivo_pago_2")
  imagen                String?
  fiscal                Boolean?
  valorBruto            Decimal?  @map("valor_bruto")              @db.Decimal(15, 2)
  iva                   Decimal?  @db.Decimal(15, 2)
  ivaRet                Decimal?  @map("iva_ret")                  @db.Decimal(15, 2)
  isrRet                Decimal?  @map("isr_ret")                  @db.Decimal(15, 2)
  ivaPorcentaje         Decimal?  @map("iva_porcentaje")           @db.Decimal(5, 2)
  ivaRetPorcentaje      Decimal?  @map("iva_ret_porcentaje")       @db.Decimal(5, 2)
  isrRetMonto           Decimal?  @map("isr_ret_monto")            @db.Decimal(15, 2)
  sede                  String?
  ejecutadoPor          String?   @map("ejecutado_por")
  fechaDeEjecucion      DateTime? @map("fecha_de_ejecucion")

  registradoPor     Tercero?          @relation("PagoEjecucionRegistradoPor",     fields: [registradoPorId],    references: [id])
  programacionPago  ProgramacionPago? @relation(                                  fields: [programacionPagoId], references: [id])
  beneficiarioGasto Tercero?          @relation("PagoEjecucionBeneficiarioGasto", fields: [beneficiarioGastoId], references: [id])
  beneficiarioPago  Tercero?          @relation("PagoEjecucionBeneficiarioPago",  fields: [beneficiarioPagoId],  references: [id])
  formaPago         FormaPago?        @relation(                                  fields: [formaPagoId],        references: [id])
  cuenta            Cuenta?           @relation(                                  fields: [cuentaId],           references: [id])
  origen            Banco?            @relation(                                  fields: [origenId],           references: [id])
  conciliarPagos    MovimientoCaja?   @relation(                                  fields: [conciliarPagosId],   references: [id])

  @@map("pagos_ejecucion")
}

model CatIva {
  id          String  @id
  valor       String
  descripcion String?

  gastos          Gasto[]
  detallesFactura DetalleFactura[]
  detalleCompras  DetalleCompra[]

  @@map("cat_iva")
}

model CatIvaRet {
  id          String @id
  descripcion String

  gastos          Gasto[]
  detallesFactura DetalleFactura[]
  detalleCompras  DetalleCompra[]

  @@map("cat_iva_ret")
}

model CatIsrRet {
  id          String @id
  descripcion String

  gastos          Gasto[]
  detallesFactura DetalleFactura[]
  detalleCompras  DetalleCompra[]

  @@map("cat_isr_ret")
}

model Proyecto {
  id              String    @id
  marcaTiempo     DateTime? @map("marca_tiempo")
  registradoPorId String?   @map("registrado_por_id")
  proyecto        String?
  descripcion     String?
  fechaInicio     DateTime? @map("fecha_inicio") @db.Date
  fechaFin        DateTime? @map("fecha_fin")    @db.Date
  estado          String?

  registradoPor Tercero? @relation(fields: [registradoPorId], references: [id])
  gastos        Gasto[]
  compras       Compra[]
  mirs          Mir[]

  @@map("proyectos")
}

model Cuenta {
  id                         String    @id
  noDeCuenta                 String?   @map("no_de_cuenta")
  clabeInterbancaria         String?   @map("clabe_interbancaria")
  bancoId                    String?   @map("banco_id")
  tipoDeCuenta               String?   @map("tipo_de_cuenta")
  tipo                       String?
  terceroId                  String?   @map("tercero_id")
  tc                         Boolean?
  montoDisponible            Decimal?  @map("monto_disponible")  @db.Decimal(15, 2)
  fechaDeCorte               DateTime? @map("fecha_de_corte")    @db.Date
  saldoInicial               Decimal?  @map("saldo_inicial")     @db.Decimal(15, 2)
  fechaDePago                DateTime? @map("fecha_de_pago")     @db.Date
  transferenciaInternacional Boolean?  @map("transferencia_internacional")
  swiftBic                   String?   @map("swift_bic")
  bancoDestino               String?   @map("banco_destino")
  direccion                  String?
  pais                       String?
  estado                     String?
  sedeId                     String?   @map("sede_id")
  cajaChica                  Boolean?  @map("caja_chica")

  banco   Banco?   @relation(fields: [bancoId],   references: [id])
  tercero Tercero? @relation(fields: [terceroId], references: [id])
  sede    Sede?    @relation(fields: [sedeId],    references: [id])

  gastosCuentaBancaria Gasto[] @relation("GastoCuentaBancaria")
  gastosCuentaDestina  Gasto[] @relation("GastoCuentaDestina")
  movimientosCaja      MovimientoCaja[]
  mirsCuentaOrigen     Mir[]   @relation("MirCuentaOrigen")
  mirsCuentaDestino    Mir[]   @relation("MirCuentaDestino")
  pagosEjecucion       PagoEjecucion[]
  abonos               Abono[]

  @@map("cuentas")
}

model Gasto {
  id                  String    @id
  usuarioId           String?   @map("usuario_id")
  marcaTiempo         DateTime? @map("marca_tiempo")
  numGasto            String?   @map("num_gasto")
  beneficiarioGastoId String?   @map("beneficiario_gasto_id")
  empresaId           String?   @map("empresa_id")
  sedeId              String?   @map("sede_id")
  fechaGasto          DateTime? @map("fecha_gasto") @db.Date
  formaPagoId         String?   @map("forma_pago_id")
  cuentaBancariaId    String?   @map("cuenta_bancaria_id")
  beneficiarioPagoId  String?   @map("beneficiario_pago_id")
  cuentaDestinaId     String?   @map("cuenta_destina_id")
  tipoGastoId         String?   @map("tipo_gasto_id")
  numDocumento        String?   @map("num_documento")
  descripcion         String?
  valor               Decimal?  @db.Decimal(15, 2)
  imagenSoporte       String?   @map("imagen_soporte")
  archivoSoporte      String?   @map("archivo_soporte")
  eliminar            Boolean   @default(false)
  ejecutar            Boolean?
  proyectoId          String?   @map("proyecto_id")
  clasificacionId     String?   @map("clasificacion_id")
  ivaId               String?   @map("iva_id")
  ivaRetId            String?   @map("iva_ret_id")
  isrRetId            String?   @map("isr_ret_id")
  tipoPersona         String?   @map("tipo_persona")
  ivaManual           Decimal?  @map("iva_manual") @db.Decimal(15, 2)
  fuenteId            String?   @map("fuente_id")
  requiereFuente      Boolean?  @map("requiere_fuente")
  ish                 Boolean?
  porcentaje          Decimal?  @db.Decimal(7, 2)
  isrForma            String?   @map("isr_forma")
  isrValor            Decimal?  @map("isr_valor")     @db.Decimal(15, 2)
  valorSinIva         Decimal?  @map("valor_sin_iva")  @db.Decimal(15, 2)

  usuario           Tercero?            @relation("GastoUsuario",           fields: [usuarioId],           references: [id])
  beneficiarioGasto Tercero?            @relation("GastoBeneficiarioGasto", fields: [beneficiarioGastoId], references: [id])
  empresa           Tercero?            @relation("GastoEmpresa",           fields: [empresaId],           references: [id])
  beneficiarioPago  Tercero?            @relation("GastoBeneficiarioPago",  fields: [beneficiarioPagoId],  references: [id])
  sede              Sede?               @relation(fields: [sedeId],          references: [id])
  formaPago         FormaPago?          @relation(fields: [formaPagoId],     references: [id])
  cuentaBancaria    Cuenta?             @relation("GastoCuentaBancaria",    fields: [cuentaBancariaId],    references: [id])
  cuentaDestina     Cuenta?             @relation("GastoCuentaDestina",     fields: [cuentaDestinaId],     references: [id])
  tipoGasto         TipoPago?           @relation(fields: [tipoGastoId],     references: [id])
  proyecto          Proyecto?           @relation(fields: [proyectoId],      references: [id])
  clasificacion     ClasificacionGasto? @relation(fields: [clasificacionId], references: [id])
  iva               CatIva?             @relation(fields: [ivaId],           references: [id])
  ivaRet            CatIvaRet?          @relation(fields: [ivaRetId],        references: [id])
  isrRet            CatIsrRet?          @relation(fields: [isrRetId],        references: [id])
  fuente            Programacion?       @relation(fields: [fuenteId],        references: [id])
  fuentes           Fuente[]
  programacionPagos ProgramacionPago[]

  @@map("gastos")
}

model Fuente {
  id              String    @id
  marcaTiempo     DateTime? @map("marca_tiempo")
  programacionId  String?   @map("programacion_id")
  gastoId         String?   @map("gasto_id")
  monto           Decimal?  @db.Decimal(15, 2)
  registradoPorId String?   @map("registrado_por_id")

  programacion  Programacion? @relation(fields: [programacionId], references: [id])
  gasto         Gasto?        @relation(fields: [gastoId],         references: [id])
  registradoPor Tercero?      @relation(fields: [registradoPorId], references: [id])

  @@map("fuentes")
}

model DocumentoProgramacion {
  id             String    @id
  programacionId String?   @map("programacion_id")
  nombre         String?
  documento      String?
  cargadoEl      DateTime? @map("cargado_el")
  cargadoPorId   String?   @map("cargado_por_id")

  programacion Programacion? @relation(fields: [programacionId], references: [id])
  cargadoPor   Tercero?      @relation(fields: [cargadoPorId],   references: [id])

  @@map("documentos_programacion")
}

model DetalleFactura {
  id               String   @id
  facturacionId    String?  @map("facturacion_id")
  productoId       String?  @map("producto_id")
  descripcion      String?
  cantidad         Decimal? @db.Decimal(10, 2)
  precioUnitario   Decimal? @map("precio_unitario") @db.Decimal(15, 2)
  descuento        Decimal? @db.Decimal(15, 2)
  codigoSat        String?  @map("codigo_sat")
  unidadMedidaId   String?  @map("unidad_medida_id")
  ivaId            String?  @map("iva_id")
  ivaRetId         String?  @map("iva_ret_id")
  isrId            String?  @map("isr_id")
  objetoImpuestoId String?  @map("objeto_impuesto_id")

  facturacion    Factura?         @relation(fields: [facturacionId],    references: [id])
  producto       Producto?        @relation(fields: [productoId],       references: [id])
  unidadMedida   UnidadMedidaSat? @relation(fields: [unidadMedidaId],   references: [id])
  iva            CatIva?          @relation(fields: [ivaId],            references: [id])
  ivaRet         CatIvaRet?       @relation(fields: [ivaRetId],         references: [id])
  isr            CatIsrRet?       @relation(fields: [isrId],            references: [id])
  objetoImpuesto ObjetoImpuesto?  @relation(fields: [objetoImpuestoId], references: [id])

  @@map("detalles_factura")
}

model Tarifa {
  id                  String     @id
  nombre              String     @unique
  especial            Boolean    @default(false)
  orden               Int?
  tipoCubrimientoId   String?    @map("tipo_cubrimiento_id")
  tipoActualizacion   Boolean?   @map("tipo_actualizacion")
  porcentajePrecio    Decimal?   @map("porcentaje_precio")    @db.Decimal(7,2)
  ultimaActualizacion DateTime?  @map("ultima_actualizacion")
  actualizadoPor      String?    @map("actualizado_por")
  actualizar          Int?
  comentarios         String?
  metodoPagoId        String?    @map("metodo_pago_id")

  tipoCubrimiento       Tarifa?    @relation("TarifaCubrimiento", fields: [tipoCubrimientoId], references: [id])
  subTarifas            Tarifa[]   @relation("TarifaCubrimiento")
  metodoPago            FormaPago? @relation(fields: [metodoPagoId], references: [id])
  terceros              Tercero[]
  remisionesTarifa      Remision[] @relation("RemisionTarifa")
  remisionesCubrimiento Remision[] @relation("RemisionCubrimiento")
  requisicionesCubrimiento Requisicion[] @relation("RequisicionCubrimiento")
  requisicionesTarifa      Requisicion[] @relation("RequisicionTarifa")
  detRequisicionesTarifaAsociada DetRequisicion[] @relation("DetRequisicionTarifaAsociada")
  listasPrecio ListaPrecio[]
  cotizacionesCubrimiento Cotizacion[] @relation("CotizacionCubrimiento")
  cotizacionesTarifa      Cotizacion[] @relation("CotizacionTarifa")

  @@map("subtarifas")
}

model Sede {
  id                       String                    @id
  nombre                   String
  ciudad                   String?
  estado                   String?
  observaciones            String?
  accesoDatos              AccesoDato[]
  programaciones           Programacion[]
  terceroSedesAutorizacion TerceroSedeAutorizacion[]
  terceroSedesDisponibles  TerceroSedeDisponible[]
