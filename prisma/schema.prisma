}

// Segundo factor de autenticación (TOTP, RFC 6238) obligatorio para todo usuario del sistema.
// El secreto se guarda cifrado (AES-256-GCM, ver totp-crypto.util.ts) — nunca en texto plano.
model TerceroTotp {
  terceroId String   @id @map("tercero_id")
  secreto   String
  activado  Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")

  tercero Tercero @relation(fields: [terceroId], references: [id], onDelete: Cascade)

  @@map("tercero_totp")
}

// Notificaciones genéricas para la campana del header. Cualquier módulo puede crear una (ver
// NotificacionesService.crear) con su propio título/mensaje/link — no hay que tocar la campana
// cada vez que se agregue un tipo nuevo (ej. próximamente: consumos por autorizar, etc.).
model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  tipo      String
  titulo    String
  mensaje   String
  link      String?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Tercero @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("notificaciones")
}

model TerceroContacto {
  id              String  @id @default(uuid())
  terceroId       String  @map("tercero_id")
  tipo            String
  dato            String
  personaContacto String? @map("persona_contacto")
  notas           String?
  principal       Boolean @default(false)

  tercero Tercero @relation(fields: [terceroId], references: [id], onDelete: Cascade)

  @@map("tercero_contactos")
}

model TerceroClasificacion {
