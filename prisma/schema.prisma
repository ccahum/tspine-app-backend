  datosFiscales            DatosFiscales?
  hospital                 Hospital?
  programacionMedicos      ProgramacionMedico[]
  programacionTecnicos     ProgramacionTecnico[]
  clasificaciones          TerceroClasificacion[]
  sedesAutorizaciones      TerceroSedeAutorizacion[]
  sedesDisponibles         TerceroSedeDisponible[]
  remisionesUsuario        Remision[]               @relation("RemisionUsuario")
  remisionesEmpresa        Remision[]               @relation("RemisionEmpresa")
  remisionesResponsable    Remision[]               @relation("RemisionResponsable")
  remisionesCliente        Remision[]               @relation("RemisionCliente")
  sistemas                 Sistema[]
  productosUsuario         Producto[]               @relation("ProductoUsuario")
  productosProveedor       Producto[]               @relation("ProductoProveedor")
  facturasGeneradaPor      Factura[]                @relation("FacturaGeneradaPor")
  facturasEmpresa          Factura[]                @relation("FacturaEmpresa")
  facturasCliente          Factura[]                @relation("FacturaCliente")
  notasCreditoAplicadaPor  NotaCredito[]            @relation("NotaCreditoAplicadaPor")
  detTecnicosTecnico       DetTecnico[]             @relation("DetTecnicoTecnico")
  valConsumosUsuario           ValConsumo[]             @relation("ValConsumoUsuario")
  valConsumosAutorizador       ValConsumo[]             @relation("ValConsumoAutorizador")
  valConsumoLotesRegistradoPor ValConsumoLote[]         @relation("ValConsumoLoteRegistradoPor")
  remTecnicosTecnico           RemTecnico[]             @relation("RemTecnicoTecnico")
  remTecnicosRegistradoPor     RemTecnico[]             @relation("RemTecnicoRegistradoPor")
  remTecnicosEditadoPor        RemTecnico[]             @relation("RemTecnicoEditadoPor")
  requisicionesUsuario         Requisicion[]            @relation("RequisicionUsuario")
  requisicionesContacto        Requisicion[]            @relation("RequisicionContacto")
  cuentas                      Cuenta[]
  proyectosRegistradoPor       Proyecto[]
  gastosUsuario                Gasto[]                  @relation("GastoUsuario")
  gastosBeneficiarioGasto      Gasto[]                  @relation("GastoBeneficiarioGasto")
  gastosEmpresa                Gasto[]                  @relation("GastoEmpresa")
  gastosBeneficiarioPago       Gasto[]                  @relation("GastoBeneficiarioPago")
  comprasProveedor             Compra[]                 @relation("CompraProveedor")
  comprasRegistradoPor         Compra[]                 @relation("CompraRegistradoPor")
  movimientosCajaUsuario       MovimientoCaja[]         @relation("MovimientoCajaUsuario")
  movimientosCajaEmpresa       MovimientoCaja[]         @relation("MovimientoCajaEmpresa")
  movimientosCajaContacto      MovimientoCaja[]         @relation("MovimientoCajaContacto")
  movimientosCajaFuncionario   MovimientoCaja[]         @relation("MovimientoCajaFuncionario")
  mirsUsuario                  Mir[]                    @relation("MirUsuario")
  mirsOrigen                   Mir[]                    @relation("MirOrigen")
  mirsDestino                  Mir[]                    @relation("MirDestino")
  programacionPagosProgramadoPor     ProgramacionPago[]  @relation("ProgramacionPagoProgramadoPor")
  programacionPagosBeneficiarioGasto ProgramacionPago[]  @relation("ProgramacionPagoBeneficiarioGasto")
  programacionPagosBeneficiarioPago  ProgramacionPago[]  @relation("ProgramacionPagoBeneficiarioPago")
  pagosEjecucionRegistradoPor        PagoEjecucion[]     @relation("PagoEjecucionRegistradoPor")
  pagosEjecucionBeneficiarioGasto    PagoEjecucion[]     @relation("PagoEjecucionBeneficiarioGasto")
  pagosEjecucionBeneficiarioPago     PagoEjecucion[]     @relation("PagoEjecucionBeneficiarioPago")
  detalleComprasEnviadorPor          DetalleCompra[]
  entradasCompraValidadoPor          EntradaCompra[]
  fuentesRegistradoPor         Fuente[]
  documentosCargadoPor         DocumentoProgramacion[]
  abonosUsuario                Abono[]                 @relation("AbonoUsuario")
  abonosTercero                Abono[]                 @relation("AbonoTercero")
  tecnicosSugeridosTecnico      TecnicoSugerido[]       @relation("TecnicoSugeridoTecnico")
  tecnicosSugeridosRegistradoPor TecnicoSugerido[]      @relation("TecnicoSugeridoRegistradoPor")
  programacionesCreadoPor      Programacion[]           @relation("ProgramacionCreadoPor")
  preciosEspeciales            PrecioEspecial[]
  cotizacionesUsuario              Cotizacion[]         @relation("CotizacionUsuario")
  cotizacionesHospital             Cotizacion[]         @relation("CotizacionHospital")
  cotizacionesResponsableEconomico Cotizacion[]         @relation("CotizacionResponsable")
  cotizacionesEmpresa              Cotizacion[]         @relation("CotizacionEmpresa")
  detCotizaHospital                DetCotiza[]          @relation("DetCotizaHospital")
  solicitudesProgramacionSolicitante SolicitudProgramacion[]      @relation("SolicitudProgramacionSolicitante")
  solicitudesProgramacionRevisor     SolicitudProgramacion[]      @relation("SolicitudProgramacionRevisor")
  solicitudesProgramacionMedico      SolicitudProgramacionMedico[]
  viajesVehiculoConductor    ViajeVehiculo[] @relation("ViajeVehiculoConductor")
  viajesVehiculoBajaPor      ViajeVehiculo[] @relation("ViajeVehiculoBajaPor")
  cargo                    Cargo?                   @relation(fields: [cargoId], references: [id])
  ciudad                   Ciudad?                  @relation(fields: [ciudadId], references: [id])
  estado                   Estado?                  @relation(fields: [estadoId], references: [id])
  pais                     Pais?                    @relation(fields: [paisId], references: [id])
  perfil                   Perfil?                  @relation(fields: [perfilId], references: [id])
  sede                     Sede?                    @relation(fields: [sedeId], references: [id])
  tarifa                   Tarifa?                  @relation(fields: [tarifaId], references: [id])
  notificaciones           Notificacion[]
