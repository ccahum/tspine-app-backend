model DetRequisicion {
  id               String    @id @map("id_detalle")
  requisicionId    String?   @map("movimiento_id")
  loteId           String?   @map("lote_id")
  productoId       String?   @map("producto_id")
  cantidad         Decimal?  @db.Decimal(10, 2)
  precio           Decimal?  @db.Decimal(15, 2)
  tarifaAsociadaId String?   @map("tarifa_asociada_id")

  requisicion    Requisicion? @relation(fields: [requisicionId],    references: [id], onDelete: Cascade)
  lote           Lote?        @relation(fields: [loteId],           references: [id])
  producto       Producto?    @relation(fields: [productoId],       references: [id])
  tarifaAsociada Tarifa?      @relation("DetRequisicionTarifaAsociada", fields: [tarifaAsociadaId], references: [id])

  @@map("det_requisiciones")
}

model PaqueteCotizacion {
  id          String  @id @map("id_paquete")
  nombre      String? @map("nombre_paquete")
  descripcion String?
  estado      String?

  detalles     DetallePaquete[]
  cotizaciones Cotizacion[]

  @@map("paquetes_cotizaciones")
}

model ListaPrecio {
  id                 String   @id @map("id_lista_precio")
  subtarifaId        String?  @map("subtarifa_id")
  productoId         String?  @map("producto_id")
  costoUtilidad      Decimal? @map("costo_utilidad")      @db.Decimal(15, 2)
  porcentajeGanancia Decimal? @map("porcentaje_ganancia") @db.Decimal(7, 2)
  precio             Decimal? @db.Decimal(15, 2)
  formaActualizacion String?  @map("forma_actualizacion")

  subtarifa Tarifa?   @relation(fields: [subtarifaId], references: [id])
  producto  Producto? @relation(fields: [productoId],  references: [id])

  @@map("listas_precio")
}

model PrecioEspecial {
  id         String   @id
  productoId String?  @map("producto_id")
  contactoId String?  @map("contacto_id")
  precio     Decimal? @db.Decimal(15, 2)
  notas      String?

  producto Producto? @relation(fields: [productoId], references: [id])
  contacto Tercero?  @relation(fields: [contactoId],  references: [id])

  @@map("precios_especiales")
}

model DetallePaquete {
  id         String @id @map("id_detalle_paquete")
  paqueteId  String? @map("paquete_id")
  productoId String? @map("producto_id")
  nivel1     Int?   @map("nivel_1")
  nivel2     Int?   @map("nivel_2")
  nivel3     Int?   @map("nivel_3")
  nivel4     Int?   @map("nivel_4")
  nivel5     Int?   @map("nivel_5")
  nivel6     Int?   @map("nivel_6")

  paquete  PaqueteCotizacion? @relation(fields: [paqueteId],  references: [id])
  producto Producto?          @relation(fields: [productoId], references: [id])
  cotizaciones Cotizacion[]

  @@map("detalle_paquetes")
}

model Cotizacion {
  id                     String    @id
  usuarioId              String?   @map("usuario_id")
  marcaDeTiempo          DateTime? @map("marca_de_tiempo")
  numCotizacion          String?   @map("num_cotizacion")
  fecha                  DateTime? @db.Date
  dirigidoA              String?   @map("dirigido_a")
  medico                 String?
  hospitalId             String?   @map("hospital_id")
  cirugia                String?
  cubrimientoId          String?   @map("cubrimiento_id")
  responsableEconomicoId String?   @map("responsable_economico_id")
  numProveedor           String?   @map("num_proveedor")
  tarifaId               String?   @map("tarifa_id")
  tiempoEntrega          String?   @map("tiempo_entrega")
  observaciones          String?
  tieneDcto              Boolean   @default(false) @map("tiene_dcto")
  porcentajeDcto         Decimal?  @map("porcentaje_dcto") @db.Decimal(5, 2)
  vrDcto                 Decimal?  @map("vr_dcto")         @db.Decimal(15, 2)
  vrDctoPesos            Decimal?  @map("vr_dcto_pesos")   @db.Decimal(15, 2)
  impuestos              String?
  nota                   String?
  imagen                 String?
  empresaId              String?   @map("empresa_id")
  status                 String?
  sedeId                 String?   @map("sede_id")
  paqueteId              String?   @map("paquete_id")
  productosPaqueteId     String?   @map("productos_paquete_id")
  contadorPaquetes       Int?      @map("contador_paquetes")
  nivel                  String?

  usuario              Tercero?           @relation("CotizacionUsuario",     fields: [usuarioId],              references: [id])
  hospital             Tercero?           @relation("CotizacionHospital",    fields: [hospitalId],             references: [id])
  cubrimiento          Tarifa?            @relation("CotizacionCubrimiento", fields: [cubrimientoId],          references: [id])
  responsableEconomico Tercero?           @relation("CotizacionResponsable", fields: [responsableEconomicoId], references: [id])
  tarifa               Tarifa?            @relation("CotizacionTarifa",      fields: [tarifaId],               references: [id])
  empresa              Tercero?           @relation("CotizacionEmpresa",     fields: [empresaId],              references: [id])
  sede                 Sede?              @relation(fields: [sedeId],             references: [id])
  paquete              PaqueteCotizacion? @relation(fields: [paqueteId],          references: [id])
  productosPaquete     DetallePaquete?    @relation(fields: [productosPaqueteId], references: [id])
  detalles             DetCotiza[]

  @@map("cotizaciones")
}

model DetCotiza {
  id            String    @id @map("id_detalle")
  cotizacionId  String?   @map("cotizacion_id")
  marcaDeTiempo DateTime? @map("marca_de_tiempo")
  hospitalId    String?   @map("hospital_id")
  referencia    String?
  productoId    String?   @map("producto_id")
  cantidad      Decimal?  @db.Decimal(10, 2)
  valorUnitario Decimal?  @map("valor_unitario") @db.Decimal(15, 2)
  valor         Decimal?  @db.Decimal(15, 2)
  observaciones String?
  sede          String?
  usuario       String?

  cotizacion Cotizacion? @relation(fields: [cotizacionId], references: [id])
  hospital   Tercero?    @relation("DetCotizaHospital", fields: [hospitalId], references: [id])
  producto   Producto?   @relation(fields: [productoId], references: [id])

  @@map("det_cotiza")
}

enum ReglaCrud {
  READ_ONLY
  ADDS_AND_UPDATES
  ALL_CHANGES
}

